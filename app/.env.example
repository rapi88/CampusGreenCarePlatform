# ===========================================
# CampusGreenCarePlatform — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# Mapbox public access token (used in the app at runtime)
# Get yours from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# Mapbox secret/download token (used for native iOS/Android builds only)
# This is a secret token (sk.*) — needed to download Mapbox SDK during native builds
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=YOUR_MAPBOX_SECRET_TOKEN_HERE

# API base URL for the backend
EXPO_PUBLIC_API_URL=http://localhost:3000/api
