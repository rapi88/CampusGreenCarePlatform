# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/campus_green_care
DIRECT_URL=postgresql://postgres:password@localhost:5432/campus_green_care

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3000
CRON_SECRET=your-random-uuid-for-cron-auth

# ─── Supabase Storage ───────────────────────────────────
# Use the service role key on the backend only. Create public buckets named
# "trees" and "avatars", or override the bucket names below.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# SUPABASE_SERVICE_ROLE_KEY is also supported if you already use that name.
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY is supported as a fallback only
# when your Storage bucket has an insert policy for that key.
SUPABASE_TREES_BUCKET=trees
SUPABASE_AVATARS_BUCKET=avatars

# ─── SMTP Email ─────────────────────────────────────────
# Required for real verification emails.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=your-app-password, SMTP_FROM="Campus Green Care <your@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Green Care <noreply@campusgreencare.gtu.edu.tr>"

# ─── Expo Push Notifications ───────────────────────────
# Get this from https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token-here
