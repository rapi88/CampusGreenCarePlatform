# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/campus_green_care

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Expo Push Notifications ───────────────────────────
# Get this from https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token-here
