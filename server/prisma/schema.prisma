// Prisma schema for Campus Green Care Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Health {
  HEALTHY  // Sağlıklı
  SICK     // Hasta
  CRITICAL // Kritik
}

// ── Models ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(USER)
  points        Int      @default(0)
  avatarUrl     String?
  expoPushToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adoptions      Adoption[]
  wateringEvents WateringEvent[]
  chatMessages   ChatMessage[]
  notes          TreeNote[]
  issueReports   IssueReport[]

  @@index([email])
  @@index([role])
}

model Tree {
  id                 String   @id @default(uuid())
  name               String
  species            String
  latitude           Float
  longitude          Float
  location           String   // Human-readable description (e.g. "Merkezi Avlu, Sektör A")
  photoPath          String?  // Local path: /uploads/trees/<filename>
  estimatedAge       Int      @default(0)
  height             Float    @default(0)
  plantingDate       DateTime?
  wateringPeriodDays Int      @default(3)
  isApproved         Boolean  @default(true)
  isNaturalMonument  Boolean  @default(false)
  health             Health   @default(HEALTHY)
  maxVolunteers      Int      @default(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adoptions      Adoption[]
  wateringEvents WateringEvent[]
  chatMessages   ChatMessage[]
  notes          TreeNote[]
  issueReports   IssueReport[]

  @@index([latitude, longitude])
}

model Adoption {
  id        String   @id @default(uuid())
  userId    String
  treeId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
  @@index([userId])
  @@index([treeId])
}

model WateringEvent {
  id            String   @id @default(uuid())
  userId        String
  treeId        String
  latitude      Float
  longitude     Float
  gpsVerified   Boolean  @default(false)
  pointsAwarded Int      @default(10)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt(sort: Desc)])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  treeId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

model TreeNote {
  id        String   @id @default(uuid())
  treeId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

model IssueReport {
  id          String   @id @default(uuid())
  treeId      String
  userId      String
  description String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([resolved])
}

model Setting {
  key   String @id
  value String
}
