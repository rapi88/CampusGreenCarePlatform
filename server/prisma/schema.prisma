generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid()) @db.VarChar(36)
  name                String
  email               String           @unique
  passwordHash        String           @db.Text
  role                Role             @default(USER)
  points              Int              @default(0)
  avatarUrl           String?          @db.Text
  expoPushToken       String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  isVerified          Boolean          @default(false)
  verifyCode          String?          @db.Text
  verifyCodeExpiresAt DateTime?
  resetCode           String?          @db.Text
  resetCodeExpiresAt  DateTime?
  adoptions           Adoption[]
  chatMessages        ChatMessage[]
  notes               TreeNote[]
  suggestions         TreeSuggestion[]
  wateringEvents      WateringEvent[]

  @@index([email])
  @@index([role])
}

model Tree {
  id                 String          @id @default(uuid()) @db.VarChar(36)
  name               String
  species            String
  latitude           Float
  longitude          Float
  location           String
  photoPath          String?         @db.Text
  estimatedAge       Int             @default(0)
  height             Float           @default(0)
  plantingDate       DateTime?
  wateringPeriodDays Int             @default(3)
  isNaturalMonument  Boolean         @default(false)
  health             Health          @default(HEALTHY)
  maxVolunteers      Int             @default(4)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  status             TreeStatus      @default(ACTIVE)
  adoptions          Adoption[]
  chatMessages       ChatMessage[]
  notes              TreeNote[]
  suggestion         TreeSuggestion?
  wateringEvents     WateringEvent[]

  @@index([latitude, longitude])
}

model Adoption {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  treeId    String   @db.VarChar(36)
  createdAt DateTime @default(now())
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
  @@index([userId])
  @@index([treeId])
}

model TreeSuggestion {
  id              String   @id @default(uuid()) @db.VarChar(36)
  treeId          String   @unique @db.VarChar(36)
  userId          String   @db.VarChar(36)
  dismissed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  rejectionReason String?  @db.Text
  tree            Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WateringEvent {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @db.VarChar(36)
  treeId        String   @db.VarChar(36)
  latitude      Float
  longitude     Float
  gpsVerified   Boolean  @default(false)
  pointsAwarded Int      @default(10)
  createdAt     DateTime @default(now())
  tree          Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt(sort: Desc)])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  treeId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  text      String   @db.Text
  createdAt DateTime @default(now())
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

model TreeNote {
  id        String   @id @default(uuid()) @db.VarChar(36)
  treeId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  text      String   @db.Text
  createdAt DateTime @default(now())
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([treeId, createdAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

enum Role {
  USER
  ADMIN
}

enum TreeStatus {
  PENDING
  DENIED
  ACTIVE
  REMOVED
}

enum Health {
  HEALTHY
  SICK
  CRITICAL
}
